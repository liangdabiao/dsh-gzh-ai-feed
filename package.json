{
  "name": "dsh-gzh-ai-feed",
  "version": "0.1.0",
  "description": "AI公众号信息源 · 每日扫描AI相关公众号按互动量发现爆款文章，智能聚类话题后生成深色主题 HTML 日报（封面图+互动数据+文章直链）。支持自定义关键词分页扫描。需 RedFox API Key，移植自 redfox-community skills/gzh-ai-feed。",
  "license": "MIT",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "src",
    "dist",
    "lib",
    "lab",
    "skills",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "wechat",
    "gongzhonghao",
    "ai-feed",
    "redfox"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "live": "node scripts/live.mjs",
    "dev": "node scripts/devserver.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10"
  }
}
